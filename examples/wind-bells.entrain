version = 1
title = "Coastal Wind with Bells"
output = "flac"
bit_depth = 24

[[voice]]
type = "soundscape"
background = "wind"
duration = "12m"

# The first 18 seconds belong to the wind. Bells leave before the end.
[[voice.cue_section]]
start = "18s"
duration = "11m12s"
cue = "bell"
cue_volume_percent = 65
cue_interval_ms = 880
fade_in = "9s"
fade_out = "24s"
